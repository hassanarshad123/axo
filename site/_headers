# Cloudflare Pages response headers for axo.zensbot.com.
# The site uses no JavaScript, no cookies and nothing from other sites.

/*
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Art never changes in place: give a changed file a new name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sparkle reads this to find updates, so it must never be stale.
/appcast.xml
  Cache-Control: no-cache
