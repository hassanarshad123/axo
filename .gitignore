# Generated by XcodeGen from project.yml
*.xcodeproj/
App/Info.plist
App/Axo.entitlements
# Older generated name, from before the rename to Axo
App/PersonalBuddy.entitlements

# Build output
build/
DerivedData/
.build/
.swiftpm/
*.xcresult

# Xcode user files
xcuserdata/
*.xcuserstate

# Release files
*.dmg
*.zip
*.p12
*.cer
*.mobileprovision
notarize-*.json

# Secrets
.env
.env.*

# macOS
.DS_Store

# Python caches from scripts/
__pycache__/

# Sheet cuts: scripts/export-buddy-assets.py makes them again on each run
design/buddies/cuts/

# Raw ElevenLabs downloads: scripts/make-voice.py keeps them here; the app ships App/Resources/Voice/*.m4a
design/voice/raw/

# Signing keys (docs/RELEASE.md). The Sparkle private key lives in ~/.secrets, never here.
*.p8
*.key
*.pem
